<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <Title>Corpo</Title>
    <Authors>TeamSports-R</Authors>
    <Company>TeamSports-R</Company>
    <Copyright>© 2026 TeamSports-R</Copyright>
    <Description>Corpo</Description>
    <Version>1.0.0</Version>

    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <RootNamespace>Corpo</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>CS9057</WarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <Configurations>ExportDebug;ExportRelease</Configurations>
    <Platforms>AnyCPU</Platforms>

    <SkipTests Condition="'$(SKIP_TESTS)' != ''">true</SkipTests>
    <RunTests>false</RunTests>
  </PropertyGroup>

  <ItemGroup>
    <!-- Production dependencies: -->
    <PackageReference Include="Chickensoft.AutoInject" Version="2.13.19" PrivateAssets="all"/>
    <PackageReference Include="Chickensoft.AutoInject.Analyzers" Version="2.13.19" PrivateAssets="all" OutputItemType="analyzer"/>
    <PackageReference Include="Chickensoft.GameTools" Version="3.1.27"/>
    <PackageReference Include="Chickensoft.GodotNodeInterfaces" Version="3.0.23"/>
    <PackageReference Include="Chickensoft.Introspection" Version="3.0.3"/>
    <PackageReference Include="Chickensoft.Introspection.Generator" PrivateAssets="all" OutputItemType="analyzer" Version="3.0.3"/>
    <PackageReference Include="Chickensoft.LogicBlocks" Version="6.1.0"/>
    <PackageReference Include="Chickensoft.LogicBlocks.Auto" Version="6.1.0"/>
    <PackageReference Include="Chickensoft.LogicBlocks.DiagramGenerator" Version="6.1.0" PrivateAssets="all" OutputItemType="analyzer"/>
    <PackageReference Include="Chickensoft.Serialization" Version="3.1.0"/>
    <PackageReference Include="GodotSharp.SourceGenerators" Version="2.7.0"/>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9"/>
    <PackageReference Include="R3" Version="1.3.1"/>
    <PackageReference Include="Serilog" Version="4.3.1"/>
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
    <PackageReference Include="StronglyTypedId" Version="1.0.0-beta08"/>
    <PackageReference Include="System.Text.Json" Version="10.0.9"/>
  </ItemGroup>


  <PropertyGroup Condition="('$(Configuration)' == 'Debug' or '$(Configuration)' == 'ExportDebug') and '$(SkipTests)' != 'true' ">
    <RunTests>true</RunTests>
    <DefineConstants>$(DefineConstants);RUN_TESTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'ExportRelease' And '$(Platform)' == 'AnyCPU'">
    <!-- We can't reliably get the GODOT_PC constant and also include the ImGui.NET package reference, so we rely on configuration only -->
    <UseImGui>true</UseImGui>
    <DefineConstants>$(DefineConstants);IMGUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="addons/"/>

    <!-- Include sources generated by prebuild -->
    <Compile Include="src/prebuild/packages/**/dist/csharp/**/*.cs"/>
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' == 'true'">
    <!-- Test dependencies: -->
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.39"/>
    <PackageReference Include="Chickensoft.GodotTestDriver" Version="3.1.72"/>
    <PackageReference Include="LightMock.Generator" Version="1.2.3"/>
    <PackageReference Include="LightMoq" Version="0.1.0"/>
    <PackageReference Include="Shouldly" Version="4.3.0"/>
  </ItemGroup>

  <ItemGroup Condition="'$(RunTests)' != 'true'">
    <Compile Remove="test/**/*.cs"/>
    <None Remove="test/**/*"/>
    <EmbeddedResource Remove="test/**/*"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="src\Corpo\Base\BaseScreen.tscn"/>
  </ItemGroup>

  <Choose>
    <When Condition="'$(UseImGui)' == 'true'">
      <ItemGroup>
        <!-- Use older version due to breaking changes -->
        <PackageReference Include="ImGui.NET" Version="1.91.6.1"/>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Compile Remove="addons/imgui-godot/**"/>
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
