<Project Sdk="Godot.NET.Sdk/4.2.1">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Scenes" />
    <Folder Include="Scripts\Game" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Scripts\Build\Generated\**" />
    <Compile Remove="Scripts\Precompilation\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Scripts\Build\Generated\**" />
    <EmbeddedResource Remove="Scripts\Precompilation\**" />
  </ItemGroup>
  <ItemGroup>
    <TypeScriptCompile Include="Scripts\Prebuild\Schema\test.ts" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Scripts\Prebuild\main.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="5.4.3" />
    <PackageReference Include="JsonSchema.Net.CodeGeneration" Version="0.1.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>