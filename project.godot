; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Corpo"
run/main_scene="uid://ct82scqrh1x11"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="uid://ce2045pqwt0jk"

[autoload]

ImGuiRoot="*res://addons/imgui-godot/data/ImGuiRoot.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false

[dotnet]

project/assembly_name="Corpo"

[editor_plugins]

enabled=PackedStringArray("res://addons/imgui-godot/plugin.cfg")

[gdunit4]

ui/toolbar/run_overall=true
templates/testsuite/CSharpScript="// GdUnit generated TestSuite

using GdUnit4;

using Godot;

namespace ${name_space} {
  using static Assertions;
  using static Utils;

  [TestSuite]
  public class ${suite_class_name} {
    // TestSuite generated from
    private const string sourceClazzPath = \"${source_resource_path}\";

  }
}
"

