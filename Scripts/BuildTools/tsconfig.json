{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "downlevelIteration": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@json/*": ["./src/json/*"],
      "@csharp/*": ["./src/csharp/*"]
    }
  },
  "include": ["src/**/*"]
}
