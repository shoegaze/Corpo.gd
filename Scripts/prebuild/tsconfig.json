{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2020",
    "module": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "downlevelIteration": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true
  },
  "include": [
    "packages/**/*"
  ]
}